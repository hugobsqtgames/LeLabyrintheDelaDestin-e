  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "validate": "tsx scripts/validate-content.ts",
    "balance": "tsx scripts/balance.ts",
    "bench": "tsx scripts/bossbench.ts",
    "lint": "expo lint",
    "promo:capture": "expo export --platform web --output-dir dist && node promo/capture.mjs --lang fr && node promo/capture.mjs --lang en",
    "promo:render": "node promo/render.mjs --lang fr && node promo/render.mjs --lang en",
    "promo:stills": "node promo/stills.mjs --lang fr && node promo/stills.mjs --lang en",
    "promo": "npm run promo:capture && npm run promo:render && npm run promo:stills"
  },
  "private": true
